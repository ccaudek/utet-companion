# =============================================================
#  utet-companion — .gitignore
# =============================================================

# ---- R: sessione e dati temporanei --------------------------
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# ---- R: credenziali (non versionare mai) --------------------
.Renviron
.env
.httr-oauth

# ---- R: build e check di pacchetti --------------------------
*-Ex.R
/*.tar.gz
/*.Rcheck/

# ---- RStudio / Positron -------------------------------------
.Rproj.user/
.positron/
# NB: il file .Rproj va invece versionato

# ---- Quarto -------------------------------------------------
# Sito reso: pubblicato sul branch gh-pages da `ghp-import -n -p -f docs`,
# quindi non va versionato su main.
docs/

# Altre cartelle di output di Quarto (assicurazione, se cambi output-dir)
_site/
_book/

# Cache interna di Quarto, a qualunque livello
.quarto/
**/*.quarto_ipynb

# Materiale intermedio del render (immagini estratte, mediabag, ecc.)
*_files/
*_cache/
/cache/
*.utf8.md
*.knit.md

# ATTENZIONE — _freeze/ NON va ignorato.
# Se usi il freeze, la cartella deve stare nel repository: è ciò che
# permette di ricostruire il sito senza rieseguire tutti i modelli.
# Stesso discorso per _extensions/ e per _quarto.yml.

# ---- Stan / CmdStanR ----------------------------------------
# Output e cache rigenerabili
_cmdstan_output/
_model_cache/

# Artefatti della compilazione, ovunque si trovino
*.o
*.d
*.hpp
*.exe

# Cartelle stan/ a qualunque livello: si ignora il contenuto ma si
# conservano i sorgenti. Il pattern deve essere NON ancorato: le
# cartelle sono chapters/modelli/stan/, chapters/calcolo/stan/, ecc.
**/stan/**
!**/stan/**/
!**/stan/**/*.stan
!**/stan/**/*.json

# Eseguibili compilati da CmdStan che stanno accanto al proprio .stan.
# Su macOS non hanno estensione, quindi non sono intercettabili con un
# glob: vanno elencati. Se aggiungi un modello nuovo, aggiungi qui il
# binario omonimo.
chapters/applicazione/study_method_decision
chapters/estensioni/binary_state_process

# Oggetti R serializzati con i fit dei modelli (rigenerabili)
*.qs
*.qs2

# ---- Grafica ------------------------------------------------
svg-inkscape/

# ---- LaTeX (se rendi in PDF) --------------------------------
*.aux
*.log
*.toc
*.out
*.synctex.gz

# ---- Vignette e pubblicazione --------------------------------
vignettes/*.html
vignettes/*.pdf
rsconnect/
po/*~

# ---- Rapporti diagnostici generati dagli script di R/ --------
check_style_report.csv
callout_senza_titolo.csv
callout_senza_titolo.md
callout_con_intestazione.csv

# ---- Sistema operativo --------------------------------------
.DS_Store
._*
Thumbs.db

# ---- renv (decommenta se lo adotti) -------------------------
# renv/library/
# renv/local/
# renv/staging/
# renv/python/
# renv.lock e renv/activate.R vanno invece versionati
