# =============================================================
#  utet-companion — .gitignore
# =============================================================

# ---- R: sessione e dati temporanei --------------------------
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# ---- R: credenziali (non versionare mai) --------------------
.Renviron
.env
.httr-oauth

# ---- R: build e check di pacchetti --------------------------
*-Ex.R
/*.tar.gz
/*.Rcheck/

# ---- RStudio / Positron -------------------------------------
.Rproj.user/
.positai
# NB: il file .Rproj va invece versionato

# ---- Quarto -------------------------------------------------
# Sito reso: pubblicato sul branch gh-pages da `ghp-import -n -p -f docs`,
# quindi non va versionato su main.
docs/
# Altre cartelle di output di Quarto (assicurazione, se cambi output-dir)
_site/
_book/
# Cache interna di Quarto, a qualunque livello
.quarto/
**/*.quarto_ipynb
# Materiale intermedio del render (immagini estratte, mediabag, ecc.)
*_files/
*_cache/
/cache/
*.utf8.md
*.knit.md

# ATTENZIONE — _freeze/ NON va ignorato.
# Se usi il freeze, la cartella deve stare nel repository: è ciò che
# permette di ricostruire il sito senza rieseguire tutti i modelli.
# Stesso discorso per _extensions/ e per _quarto.yml.

# ---- Stan / CmdStanR ----------------------------------------

# Output e cache rigenerabili
_cmdstan_output/
_model_cache/

# Ignora tutti gli artefatti nella cartella dei modelli Stan
/stan/**

# Mantieni visibili le directory, necessarie per applicare le eccezioni
!/stan/**/

# Conserva i sorgenti Stan
!/stan/**/*.stan

# ---- Grafica ------------------------------------------------
svg-inkscape/

# ---- LaTeX (se rendi in PDF) --------------------------------
*.aux
*.log
*.toc
*.out
*.synctex.gz

# ---- Vignette e pubblicazione --------------------------------
vignettes/*.html
vignettes/*.pdf
rsconnect/
po/*~

# ---- Sistema operativo --------------------------------------
.DS_Store
**/.DS_Store
._*
Thumbs.db

# ---- renv (decommenta se lo adotti) -------------------------
# renv/library/
# renv/local/
# renv/staging/
# renv/python/
# renv.lock e renv/activate.R vanno invece versionati

/.quarto/
